            adj[20] += adj[22] * nodes[21];
            adj[21] += adj[22] * nodes[20];
            adj[1] += adj[21] / nodes[16];
            adj[16] -= adj[21] * nodes[1] / (nodes[16] * nodes[16]);
            adj[1] += adj[20] / nodes[16];
            adj[16] -= adj[20] * nodes[1] / (nodes[16] * nodes[16]);
