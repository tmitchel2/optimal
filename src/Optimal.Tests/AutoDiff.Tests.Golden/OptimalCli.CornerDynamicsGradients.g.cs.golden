            nodes[19] = -nodes[18];
            nodes[20] = (nodes[16] != 0) ? nodes[17] : nodes[19];
            nodes[21] = (nodes[14] != 0) ? nodes[20] : nodes[11];
            var safeCos = nodes[21];
            nodes[3] = V;
            nodes[22] = nodes[3] * nodes[21];
            nodes[23] = nodes[10] / nodes[22];

            var adj = new double[24];
            adj[23] = 1.0;

            adj[10] += adj[23] / nodes[22];
            adj[22] -= adj[23] * nodes[10] / (nodes[22] * nodes[22]);
