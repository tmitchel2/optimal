            nodes[10] = 1.0;
            nodes[11] = (nodes[9] != 0) ? nodes[10] : nodes[5];
            var safeFxMax = nodes[11];
            nodes[12] = Math.Abs(nodes[6]);
            nodes[13] = 1.0;
