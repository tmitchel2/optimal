                adj[6] += adj[10];
            }
            adj[4] += adj[6];
            adj[5] -= adj[6];
            adj[1] += adj[5] * nodes[0];
            adj[0] += adj[5] * nodes[1];
            return (nodes[23], new double[] { adj[0], adj[1], adj[2], adj[3] });
        }

