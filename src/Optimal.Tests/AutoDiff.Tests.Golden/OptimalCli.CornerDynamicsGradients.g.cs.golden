        public static (double value, double gradient) SpeedRateSForward_kappa(
            double kappa, double n, double alpha, double V, double ax, double rho, double CdA, double M)
        {
            var kappa_tan = 1.0;
            var n_tan = 0.0;
            var alpha_tan = 0.0;
            var V_tan = 0.0;
            var ax_tan = 0.0;
            var rho_tan = 0.0;
            var CdA_tan = 0.0;
            var M_tan = 0.0;

            var node0 = 0.5 * rho;
            var node0_tan = 0.5 * 0.0 + rho * 0.0;
            var node1 = node0 * V;
            var node1_tan = node0 * 0.0 + V * node0_tan;
            var node2 = node1 * V;
            var node2_tan = node1 * 0.0 + V * node1_tan;
            var node3 = node2 * CdA;
            var node3_tan = node2 * 0.0 + CdA * node2_tan;
            var node4 = node3 / M;
            var node4_tan = (M * node3_tan - node3 * 0.0) / (M * M);
            var drag = node4;
            var drag_tan = node4_tan;
            var node5 = n * kappa;
            var node5_tan = n * kappa_tan + kappa * 0.0;
            var node6 = 1.0 - node5;
            var node6_tan = 0.0 - node5_tan;
            var denom = node6;
            var denom_tan = node6_tan;
            var node7 = node6 < 0.10000000000000001;
            var node7_tan = 0.0;
            var node8 = (node7 ? 0.10000000000000001 : node6);
            var node8_tan = (node7 ? 0.0 : node6_tan);
            var safeDenom = node8;
