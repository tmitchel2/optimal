        public static (double value, double gradient) FrictionCoeffForward_Fz(
            double Fz, double Fz_nom, double mu0, double Kmu)
        {
            var Fz_tan = 1.0;
            var Fz_nom_tan = 0.0;
            var mu0_tan = 0.0;
            var Kmu_tan = 0.0;

            var node0 = Fz / Fz_nom;
            var node0_tan = (Fz_nom * Fz_tan - Fz * 0.0) / (Fz_nom * Fz_nom);
            var node1 = node0 - 1.0;
            var node1_tan = node0_tan - 0.0;
            var node2 = Kmu * node1;
            var node2_tan = Kmu * node1_tan + node1 * 0.0;
            var node3 = 1.0 + node2;
            var node3_tan = 0.0 + node2_tan;
            var node4 = mu0 * node3;
            var node4_tan = mu0 * node3_tan + node3 * 0.0;

            return (node4, node4_tan);
        }

