        {
            var nodes = new double[13];

            nodes[0] = x;
            nodes[1] = y;
            nodes[0] = x;
            nodes[2] = 1.0;
            nodes[3] = nodes[0] - nodes[2];
            nodes[4] = 1.0;
            nodes[5] = nodes[0] - nodes[4];
            nodes[6] = nodes[3] * nodes[5];
            nodes[1] = y;
            nodes[7] = 1.0;
            nodes[8] = nodes[1] - nodes[7];
            nodes[9] = 1.0;
            nodes[10] = nodes[1] - nodes[9];
            nodes[11] = nodes[8] * nodes[10];
            nodes[12] = nodes[6] + nodes[11];

            var adj = new double[13];
            adj[12] = 1.0;

            adj[6] += adj[12];
            adj[11] += adj[12];
            adj[8] += adj[11] * nodes[10];
            adj[10] += adj[11] * nodes[8];
            adj[1] += adj[10];
            adj[9] -= adj[10];
            adj[1] += adj[8];
            adj[7] -= adj[8];
            adj[3] += adj[6] * nodes[5];
            adj[5] += adj[6] * nodes[3];
            adj[0] += adj[5];
            adj[4] -= adj[5];
            adj[0] += adj[3];
            adj[2] -= adj[3];
            return (nodes[12], new double[] { adj[0], adj[1] });
        }

    }
}
