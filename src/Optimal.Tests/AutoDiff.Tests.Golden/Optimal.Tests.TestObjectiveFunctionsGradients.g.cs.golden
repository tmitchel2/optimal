        public static (double value, double gradient) UnitCircleConstraintForward_x(
            double x, double y)
        {
            var x_tan = 1.0;
            var y_tan = 0.0;

            var node0 = x * x;
            var node0_tan = x * x_tan + x * x_tan;
            var node1 = y * y;
            var node1_tan = y * 0.0 + y * 0.0;
            var node2 = node0 + node1;
            var node2_tan = node0_tan + node1_tan;
            var node3 = node2 - 1.0;
            var node3_tan = node2_tan - 0.0;

            return (node3, node3_tan);
        }

