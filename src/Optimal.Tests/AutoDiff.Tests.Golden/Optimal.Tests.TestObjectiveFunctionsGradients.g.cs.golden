        public static (double value, double gradient) LinearEqualityConstraintForward_x(
            double x, double y)
        {
            var x_tan = 1.0;
            var y_tan = 0.0;

            var node0 = x + y;
            var node0_tan = x_tan + 0.0;
            var node1 = node0 - 1.0;
            var node1_tan = node0_tan - 0.0;

            return (node1, node1_tan);
        }

