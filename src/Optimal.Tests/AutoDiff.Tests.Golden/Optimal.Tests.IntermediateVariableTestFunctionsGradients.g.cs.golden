            nodes[0] = x;
            nodes[1] = 1.0;
            nodes[2] = nodes[0] + nodes[1];
            nodes[3] = 1.0;
            nodes[4] = nodes[0] + nodes[3];
            nodes[5] = nodes[2] * nodes[4];
            nodes[6] = 1.0;
            nodes[7] = nodes[0] + nodes[6];
            nodes[8] = nodes[5] * nodes[7];
            nodes[9] = 1.0;
            nodes[10] = nodes[0] + nodes[9];
            nodes[11] = nodes[8] * nodes[10];
            nodes[12] = 1.0;
            nodes[13] = nodes[0] + nodes[12];
            nodes[14] = nodes[11] * nodes[13];
            nodes[15] = 1.0;
            nodes[16] = nodes[0] + nodes[15];
            nodes[17] = nodes[14] * nodes[16];

            var adj = new double[18];
            adj[17] = 1.0;

            adj[14] += adj[17] * nodes[16];
            adj[16] += adj[17] * nodes[14];
            adj[0] += adj[16];
            adj[15] += adj[16];
            adj[11] += adj[14] * nodes[13];
            adj[13] += adj[14] * nodes[11];
            adj[0] += adj[13];
            adj[12] += adj[13];
            adj[8] += adj[11] * nodes[10];
            adj[10] += adj[11] * nodes[8];
            adj[0] += adj[10];
            adj[9] += adj[10];
            adj[5] += adj[8] * nodes[7];
            adj[7] += adj[8] * nodes[5];
            adj[0] += adj[7];
            adj[6] += adj[7];
            adj[2] += adj[5] * nodes[4];
            adj[4] += adj[5] * nodes[2];
            adj[0] += adj[4];
            adj[3] += adj[4];
            adj[0] += adj[2];
            adj[1] += adj[2];
            return (nodes[17], new double[] { adj[0] });
        }

    }
