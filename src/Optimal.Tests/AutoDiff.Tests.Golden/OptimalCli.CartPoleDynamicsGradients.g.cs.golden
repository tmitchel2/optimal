        public static (double value, double[] gradients) XddotRateReverse(
            double x, double xdot, double theta, double thetadot, double F, double M, double m, double L, double g)
        {
            var nodes = new double[27];

            nodes[0] = x;
            nodes[1] = xdot;
            nodes[2] = theta;
            nodes[3] = thetadot;
            nodes[4] = F;
            nodes[5] = M;
            nodes[6] = m;
            nodes[7] = L;
            nodes[8] = g;
            nodes[4] = F;
            nodes[6] = m;
            nodes[7] = L;
            nodes[9] = nodes[6] * nodes[7];
            nodes[3] = thetadot;
            nodes[10] = nodes[9] * nodes[3];
            nodes[11] = nodes[10] * nodes[3];
            nodes[2] = theta;
            nodes[12] = Math.Sin(nodes[2]);
            nodes[13] = nodes[11] * nodes[12];
            nodes[14] = nodes[4] + nodes[13];
            nodes[8] = g;
            nodes[15] = nodes[6] * nodes[8];
            nodes[16] = Math.Sin(nodes[2]);
            nodes[17] = nodes[15] * nodes[16];
            nodes[18] = Math.Cos(nodes[2]);
            nodes[19] = nodes[17] * nodes[18];
            nodes[20] = nodes[14] - nodes[19];
            nodes[5] = M;
            nodes[21] = Math.Sin(nodes[2]);
            nodes[22] = nodes[6] * nodes[21];
            nodes[23] = Math.Sin(nodes[2]);
            nodes[24] = nodes[22] * nodes[23];
            nodes[25] = nodes[5] + nodes[24];
            nodes[26] = nodes[20] / nodes[25];

            var adj = new double[27];
            adj[26] = 1.0;

            adj[20] += adj[26] / nodes[25];
            adj[25] -= adj[26] * nodes[20] / (nodes[25] * nodes[25]);
            adj[5] += adj[25];
            adj[24] += adj[25];
            adj[22] += adj[24] * nodes[23];
            adj[23] += adj[24] * nodes[22];
            adj[2] += adj[23] * Math.Cos(nodes[2]);
            adj[6] += adj[22] * nodes[21];
            adj[21] += adj[22] * nodes[6];
            adj[2] += adj[21] * Math.Cos(nodes[2]);
            adj[14] += adj[20];
            adj[19] -= adj[20];
            adj[17] += adj[19] * nodes[18];
            adj[18] += adj[19] * nodes[17];
            adj[2] -= adj[18] * Math.Sin(nodes[2]);
            adj[15] += adj[17] * nodes[16];
            adj[16] += adj[17] * nodes[15];
            adj[2] += adj[16] * Math.Cos(nodes[2]);
            adj[6] += adj[15] * nodes[8];
            adj[8] += adj[15] * nodes[6];
            adj[4] += adj[14];
            adj[13] += adj[14];
            adj[11] += adj[13] * nodes[12];
            adj[12] += adj[13] * nodes[11];
            adj[2] += adj[12] * Math.Cos(nodes[2]);
            adj[10] += adj[11] * nodes[3];
            adj[3] += adj[11] * nodes[10];
            adj[9] += adj[10] * nodes[3];
            adj[3] += adj[10] * nodes[9];
            adj[6] += adj[9] * nodes[7];
            adj[7] += adj[9] * nodes[6];
            return (nodes[26], new double[] { adj[0], adj[1], adj[2], adj[3], adj[4], adj[5], adj[6], adj[7], adj[8] });
        }

