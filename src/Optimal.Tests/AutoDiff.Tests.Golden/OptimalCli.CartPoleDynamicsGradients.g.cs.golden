        public static (double value, double[] gradients) ThetaddotRateReverse(
            double x, double xdot, double theta, double thetadot, double F, double M, double m, double L, double g)
        {
            var nodes = new double[34];

            nodes[0] = x;
            nodes[1] = xdot;
            nodes[2] = theta;
            nodes[3] = thetadot;
            nodes[4] = F;
            nodes[5] = M;
            nodes[6] = m;
            nodes[7] = L;
            nodes[8] = g;
            nodes[8] = g;
            nodes[2] = theta;
            nodes[9] = Math.Sin(nodes[2]);
            nodes[10] = nodes[8] * nodes[9];
            nodes[11] = Math.Cos(nodes[2]);
            nodes[4] = F;
            nodes[6] = m;
            nodes[7] = L;
            nodes[12] = nodes[6] * nodes[7];
            nodes[3] = thetadot;
            nodes[13] = nodes[12] * nodes[3];
            nodes[14] = nodes[13] * nodes[3];
            nodes[15] = Math.Sin(nodes[2]);
            nodes[16] = nodes[14] * nodes[15];
            nodes[17] = nodes[4] + nodes[16];
            nodes[18] = nodes[11] * nodes[17];
            nodes[5] = M;
            nodes[19] = nodes[5] + nodes[6];
            nodes[20] = nodes[18] / nodes[19];
            nodes[21] = nodes[10] - nodes[20];
            nodes[22] = 4.0;
            nodes[23] = 3.0;
            nodes[24] = nodes[22] / nodes[23];
            nodes[25] = Math.Cos(nodes[2]);
            nodes[26] = nodes[6] * nodes[25];
            nodes[27] = Math.Cos(nodes[2]);
            nodes[28] = nodes[26] * nodes[27];
            nodes[29] = nodes[5] + nodes[6];
            nodes[30] = nodes[28] / nodes[29];
            nodes[31] = nodes[24] - nodes[30];
            nodes[32] = nodes[7] * nodes[31];
            nodes[33] = nodes[21] / nodes[32];

            var adj = new double[34];
            adj[33] = 1.0;

            adj[21] += adj[33] / nodes[32];
            adj[32] -= adj[33] * nodes[21] / (nodes[32] * nodes[32]);
            adj[7] += adj[32] * nodes[31];
            adj[31] += adj[32] * nodes[7];
            adj[24] += adj[31];
            adj[30] -= adj[31];
            adj[28] += adj[30] / nodes[29];
            adj[29] -= adj[30] * nodes[28] / (nodes[29] * nodes[29]);
            adj[5] += adj[29];
            adj[6] += adj[29];
            adj[26] += adj[28] * nodes[27];
            adj[27] += adj[28] * nodes[26];
            adj[2] -= adj[27] * Math.Sin(nodes[2]);
            adj[6] += adj[26] * nodes[25];
            adj[25] += adj[26] * nodes[6];
            adj[2] -= adj[25] * Math.Sin(nodes[2]);
            adj[22] += adj[24] / nodes[23];
            adj[23] -= adj[24] * nodes[22] / (nodes[23] * nodes[23]);
            adj[10] += adj[21];
            adj[20] -= adj[21];
            adj[18] += adj[20] / nodes[19];
            adj[19] -= adj[20] * nodes[18] / (nodes[19] * nodes[19]);
            adj[5] += adj[19];
            adj[6] += adj[19];
            adj[11] += adj[18] * nodes[17];
            adj[17] += adj[18] * nodes[11];
            adj[4] += adj[17];
            adj[16] += adj[17];
            adj[14] += adj[16] * nodes[15];
            adj[15] += adj[16] * nodes[14];
            adj[2] += adj[15] * Math.Cos(nodes[2]);
            adj[13] += adj[14] * nodes[3];
            adj[3] += adj[14] * nodes[13];
            adj[12] += adj[13] * nodes[3];
            adj[3] += adj[13] * nodes[12];
            adj[6] += adj[12] * nodes[7];
            adj[7] += adj[12] * nodes[6];
            adj[2] -= adj[11] * Math.Sin(nodes[2]);
            adj[8] += adj[10] * nodes[9];
            adj[9] += adj[10] * nodes[8];
            adj[2] += adj[9] * Math.Cos(nodes[2]);
            return (nodes[33], new double[] { adj[0], adj[1], adj[2], adj[3], adj[4], adj[5], adj[6], adj[7], adj[8] });
        }

        public static (double value, double gradient) RunningCostForward_x(
            double x, double xdot, double theta, double thetadot, double F)
        {
            var x_tan = 1.0;
            var xdot_tan = 0.0;
            var theta_tan = 0.0;
            var thetadot_tan = 0.0;
            var F_tan = 0.0;

            var node0 = 20.0 * x;
            var node0_tan = 20.0 * x_tan + x * 0.0;
            var node1 = node0 * x;
            var node1_tan = node0 * x_tan + x * node0_tan;
            var node2 = 2.0 * xdot;
            var node2_tan = 2.0 * 0.0 + xdot * 0.0;
            var node3 = node2 * xdot;
            var node3_tan = node2 * 0.0 + xdot * node2_tan;
            var node4 = node1 + node3;
            var node4_tan = node1_tan + node3_tan;
            var node5 = 50.0 * theta;
            var node5_tan = 50.0 * 0.0 + theta * 0.0;
            var node6 = node5 * theta;
            var node6_tan = node5 * 0.0 + theta * node5_tan;
            var node7 = node4 + node6;
            var node7_tan = node4_tan + node6_tan;
            var node8 = 2.0 * thetadot;
            var node8_tan = 2.0 * 0.0 + thetadot * 0.0;
            var node9 = node8 * thetadot;
            var node9_tan = node8 * 0.0 + thetadot * node8_tan;
            var node10 = node7 + node9;
            var node10_tan = node7_tan + node9_tan;
            var node11 = 0.5 * F;
            var node11_tan = 0.5 * 0.0 + F * 0.0;
            var node12 = node11 * F;
            var node12_tan = node11 * 0.0 + F * node11_tan;
            var node13 = node10 + node12;
            var node13_tan = node10_tan + node12_tan;

            return (node13, node13_tan);
        }

