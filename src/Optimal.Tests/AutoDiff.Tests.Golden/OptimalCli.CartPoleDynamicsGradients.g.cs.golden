            return (node13, node13_tan);
        }

        public static (double value, double gradient) RunningCostForward_F(
            double x, double xdot, double theta, double thetadot, double F)
        {
            var x_tan = 0.0;
            var xdot_tan = 0.0;
            var theta_tan = 0.0;
            var thetadot_tan = 0.0;
            var F_tan = 1.0;

            var node0 = 20.0 * x;
            var node0_tan = 20.0 * 0.0 + x * 0.0;
            var node1 = node0 * x;
            var node1_tan = node0 * 0.0 + x * node0_tan;
            var node2 = 2.0 * xdot;
            var node2_tan = 2.0 * 0.0 + xdot * 0.0;
            var node3 = node2 * xdot;
            var node3_tan = node2 * 0.0 + xdot * node2_tan;
            var node4 = node1 + node3;
            var node4_tan = node1_tan + node3_tan;
            var node5 = 50.0 * theta;
            var node5_tan = 50.0 * 0.0 + theta * 0.0;
            var node6 = node5 * theta;
            var node6_tan = node5 * 0.0 + theta * node5_tan;
            var node7 = node4 + node6;
            var node7_tan = node4_tan + node6_tan;
            var node8 = 2.0 * thetadot;
            var node8_tan = 2.0 * 0.0 + thetadot * 0.0;
            var node9 = node8 * thetadot;
            var node9_tan = node8 * 0.0 + thetadot * node8_tan;
            var node10 = node7 + node9;
            var node10_tan = node7_tan + node9_tan;
            var node11 = 0.5 * F;
            var node11_tan = 0.5 * F_tan + F * 0.0;
            var node12 = node11 * F;
            var node12_tan = node11 * F_tan + F * node11_tan;
            var node13 = node10 + node12;
            var node13_tan = node10_tan + node12_tan;

            return (node13, node13_tan);
        }

        public static (double value, double[] gradients) RunningCostReverse(
            double x, double xdot, double theta, double thetadot, double F)
        {
            var nodes = new double[24];

            nodes[0] = x;
            nodes[1] = xdot;
            nodes[2] = theta;
            nodes[3] = thetadot;
            nodes[4] = F;
            nodes[5] = 20.0;
            nodes[0] = x;
            nodes[6] = nodes[5] * nodes[0];
            nodes[7] = nodes[6] * nodes[0];
            nodes[8] = 2.0;
            nodes[1] = xdot;
            nodes[9] = nodes[8] * nodes[1];
            nodes[10] = nodes[9] * nodes[1];
            nodes[11] = nodes[7] + nodes[10];
            nodes[12] = 50.0;
            nodes[2] = theta;
            nodes[13] = nodes[12] * nodes[2];
            nodes[14] = nodes[13] * nodes[2];
            nodes[15] = nodes[11] + nodes[14];
            nodes[16] = 2.0;
            nodes[3] = thetadot;
            nodes[17] = nodes[16] * nodes[3];
            nodes[18] = nodes[17] * nodes[3];
            nodes[19] = nodes[15] + nodes[18];
            nodes[20] = 0.5;
            nodes[4] = F;
            nodes[21] = nodes[20] * nodes[4];
            nodes[22] = nodes[21] * nodes[4];
            nodes[23] = nodes[19] + nodes[22];

            var adj = new double[24];
            adj[23] = 1.0;

            adj[19] += adj[23];
            adj[22] += adj[23];
            adj[21] += adj[22] * nodes[4];
            adj[4] += adj[22] * nodes[21];
            adj[20] += adj[21] * nodes[4];
            adj[4] += adj[21] * nodes[20];
            adj[15] += adj[19];
            adj[18] += adj[19];
            adj[17] += adj[18] * nodes[3];
            adj[3] += adj[18] * nodes[17];
            adj[16] += adj[17] * nodes[3];
            adj[3] += adj[17] * nodes[16];
            adj[11] += adj[15];
            adj[14] += adj[15];
            adj[13] += adj[14] * nodes[2];
            adj[2] += adj[14] * nodes[13];
            adj[12] += adj[13] * nodes[2];
            adj[2] += adj[13] * nodes[12];
            adj[7] += adj[11];
            adj[10] += adj[11];
            adj[9] += adj[10] * nodes[1];
            adj[1] += adj[10] * nodes[9];
            adj[8] += adj[9] * nodes[1];
            adj[1] += adj[9] * nodes[8];
            adj[6] += adj[7] * nodes[0];
            adj[0] += adj[7] * nodes[6];
            adj[5] += adj[6] * nodes[0];
            adj[0] += adj[6] * nodes[5];
            return (nodes[23], new double[] { adj[0], adj[1], adj[2], adj[3], adj[4] });
        }

    }
}
