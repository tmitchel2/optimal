            nodes[3] = T;
            nodes[8] = -nodes[3];
            nodes[6] = c;
            nodes[9] = nodes[8] / nodes[6];

            var adj = new double[10];
            adj[9] = 1.0;

            adj[8] += adj[9] / nodes[6];
            adj[6] -= adj[9] * nodes[8] / (nodes[6] * nodes[6]);
            adj[3] -= adj[8];
            return (nodes[9], new double[] { adj[0], adj[1], adj[2], adj[3], adj[4], adj[5], adj[6], adj[7] });
        }

        public static (double value, double gradient) RunningCostForward_h(
            double h, double v, double m, double T)
        {
            var h_tan = 1.0;
            var v_tan = 0.0;
            var m_tan = 0.0;
            var T_tan = 0.0;


            return (0.0, 0.0);
        }

        public static (double value, double gradient) RunningCostForward_v(
            double h, double v, double m, double T)
        {
            var h_tan = 0.0;
            var v_tan = 1.0;
            var m_tan = 0.0;
            var T_tan = 0.0;


            return (0.0, 0.0);
        }

        public static (double value, double gradient) RunningCostForward_m(
            double h, double v, double m, double T)
        {
            var h_tan = 0.0;
            var v_tan = 0.0;
            var m_tan = 1.0;
            var T_tan = 0.0;


            return (0.0, 0.0);
        }

        public static (double value, double gradient) RunningCostForward_T(
            double h, double v, double m, double T)
        {
            var h_tan = 0.0;
            var v_tan = 0.0;
            var m_tan = 0.0;
            var T_tan = 1.0;


            return (0.0, 0.0);
        }

        public static (double value, double[] gradients) RunningCostReverse(
            double h, double v, double m, double T)
        {
            var nodes = new double[5];

            nodes[0] = h;
            nodes[1] = v;
            nodes[2] = m;
            nodes[3] = T;
            nodes[4] = 0.0;

            var adj = new double[5];
            adj[4] = 1.0;

            return (nodes[4], new double[] { adj[0], adj[1], adj[2], adj[3] });
        }

        public static (double value, double gradient) TerminalCostForward_h(
            double h, double v, double m)
        {
            var h_tan = 1.0;
            var v_tan = 0.0;
            var m_tan = 0.0;

            var node0 = -h;
            var node0_tan = -h_tan;

            return (node0, node0_tan);
        }

        public static (double value, double gradient) TerminalCostForward_v(
            double h, double v, double m)
        {
            var h_tan = 0.0;
            var v_tan = 1.0;
            var m_tan = 0.0;

            var node0 = -h;
            var node0_tan = -0.0;

            return (node0, node0_tan);
        }

        public static (double value, double gradient) TerminalCostForward_m(
            double h, double v, double m)
        {
            var h_tan = 0.0;
            var v_tan = 0.0;
            var m_tan = 1.0;

            var node0 = -h;
            var node0_tan = -0.0;

            return (node0, node0_tan);
        }

        public static (double value, double[] gradients) TerminalCostReverse(
            double h, double v, double m)
        {
            var nodes = new double[4];

            nodes[0] = h;
            nodes[1] = v;
            nodes[2] = m;
            nodes[0] = h;
            nodes[3] = -nodes[0];

            var adj = new double[4];
            adj[3] = 1.0;

            adj[0] -= adj[3];
            return (nodes[3], new double[] { adj[0], adj[1], adj[2] });
        }

    }
}
